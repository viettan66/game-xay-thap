# --- Dữ liệu chạy thật: DB, avatar, backup, log (mỗi hồ sơ một thư mục con) ---
data/

# --- Config đang dùng (sửa qua admin, được backup cùng DB). Bản mặc định nằm trong config/defaults/ ---
/config/*.json
/config/*.tmp

# --- Bí mật: API key. Chỉ commit file mẫu .env.example ---
.env
.env.*
!.env.example

# --- Thư viện cài bằng npm ---
node_modules/

# --- Kết quả build, cache ---
dist/
/build/
.vite/
*.tsbuildinfo
vite.config.*.timestamp-*
coverage/
.cache/

# --- Log ---
logs/
*.log
npm-debug.log*

# --- Python (script xử lý ảnh ở giai đoạn 3) ---
__pycache__/
*.pyc
.venv/

# --- File rác của hệ điều hành và trình soạn thảo ---
Thumbs.db
desktop.ini
.DS_Store
*.swp

# --- Ảnh trung gian khi xử lý đồ họa (tạo lại được bằng script) và công cụ tải về ---
assets/work/
.tools/

# --- Âm thanh: file nhạc, hiệu ứng và credits.json do chủ dự án tự thêm (bản quyền riêng, repo công khai).
#     Chỉ đưa lên git cây thư mục kèm README.txt mô tả loại âm cần đặt vào ---
/assets/audio/**
!/assets/audio/**/
!/assets/audio/**/README.txt
