{
  "name": "bao-thap-thien-phuc",
  "version": "0.1.0",
  "private": true,
  "description": "Bảo Tháp Thiên Phúc – overlay game livestream xây tháp 100 tầng",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --import tsx server/main.ts --profile=production",
    "start:test": "node --import tsx server/main.ts --profile=test",
    "dev": "node --import tsx --watch server/main.ts --profile=test",
    "dev:overlay": "vite --config overlay/vite.config.ts",
    "build": "vite build --config overlay/vite.config.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p overlay"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "pixi.js": "^8.22.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
